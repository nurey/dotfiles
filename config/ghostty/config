# Ghostty configuration
# Docs: https://ghostty.org/docs/config
# View all options + defaults: `ghostty +show-config --default --docs`
# Reload while running: Cmd+Shift+, (macOS)

working-directory = inherit
auto-update = off
# Install Ghostty terminfo on SSH hosts and fall back to xterm-256color
shell-integration-features = ssh-terminfo,ssh-env
